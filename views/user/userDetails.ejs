<% layout("/layout/boilerplate") %>

<%
const initial = (user.name || user.username || "?")
    .trim()
    .charAt(0)
    .toUpperCase();
%>

<div class="profile-wrapper">

    <div class="profile-card">

        <div class="profile-cover"></div>

        <div class="profile-head">

            <% if (user.profileImage) { %>

                <div class="profile-avatar">
                    <img
                        src="/uploads/<%= user.profileImage %>"
                        alt="Profile photo of <%= user.name %>">
                </div>

            <% } else { %>

                <div class="profile-avatar">
                    <%= initial %>
                </div>

            <% } %>

            <div class="profile-meta">

                <h2><%= user.name %></h2>

                <span>@<%= user.username %></span>

            </div>

        </div>


        <form
            action="/userdetail/change"
            method="POST"
            enctype="multipart/form-data"
            data-success="saved">

            <div class="form-grid">

                <div class="field">

                    <label for="name">Full Name</label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= user.name %>"
                        placeholder="Your name"
                        required>

                </div>

                <div class="field">

                    <label for="age">Age</label>

                    <input
                        type="number"
                        id="age"
                        name="age"
                        value="<%= user.age %>"
                        min="1"
                        max="120"
                        placeholder="Your age">

                </div>

                <div class="field full">

                    <label for="username">Username</label>

                    <input
                        type="text"
                        id="username"
                        value="<%= user.username %>"
                        disabled>

                </div>

                <div class="field full">

                    <label for="profileImage">Profile Photo</label>

                    <div class="file-field">

                        <input
                            type="file"
                            id="profileImage"
                            name="profileImage"
                            accept="image/*">

                        <label class="file-label" for="profileImage">

                            <i class="fa-solid fa-camera"></i>

                            <span id="fileLabel">
                                Choose a photo (JPG or PNG)
                            </span>

                        </label>

                    </div>

                </div>

            </div>

            <button type="submit" class="save-btn" data-busy="Saving…">
                Save Changes
            </button>

        </form>

    </div>

</div>


<script>

const fileInput = document.getElementById("profileImage");
const fileLabel = document.getElementById("fileLabel");

if (fileInput && fileLabel) {

    fileInput.addEventListener("change", function () {

        fileLabel.textContent =
            this.files && this.files[0]
                ? this.files[0].name
                : "Choose a photo (JPG or PNG)";

    });

}

</script>
