<% layout("/layout/boilerplate") %>

<div class="profile-wrapper">

    <div class="transaction-card">

        <div class="transaction-icon">
            💰
        </div>

        <h2>Add Transaction</h2>

        <form method="POST" action="/transaction">

            <label for="title">Title</label>
            <input
                type="text"
                name="title"
                id="title"
                placeholder="Enter title"
                required
            >

            <label for="amount">Amount</label>
            <input
                type="number"
                name="amount"
                id="amount"
                placeholder="Enter amount"
                required
            >

            <label for="type">Transaction Type</label>
            <select name="type" id="type">
                <option value="income">Income</option>
                <option value="expense">Expense</option>
            </select>

           <label for="category">Category</label>
<select name="category" id="category">
</select>

            <label for="date">Date</label>
            <input
                type="date"
                name="date"
                id="date"
                required
            >

            <button class="save-btn">
                Add Transaction
            </button>

        </form>

    </div>

</div>

<script>

const incomeCategories = [
"Salary",
"Freelancing",
"Business",
"Investment",
"Bonus",
"Gift Received",
"Rental Income",
"Refund",
"Cashback",
"Other Income"
];

const expenseCategories = [
"Food",
"Groceries",
"Rent",
"Electricity",
"Water Bill",
"Gas Bill",
"Internet",
"Mobile Recharge",
"Transportation",
"Fuel",
"Shopping",
"Clothing",
"Healthcare",
"Medicine",
"Education",
"Entertainment",
"Travel",
"Subscription",
"EMI / Loan",
"Personal Care",
"Pets",
"Charity",
"Family",
"Maintenance",
"Gifts",
"Other Expense"
];

const emojiMap = {

Salary:"💼",
Freelancing:"💻",
Business:"🏢",
Investment:"📈",
Bonus:"💰",
"Gift Received":"🎁",
"Rental Income":"🏠",
Refund:"💸",
Cashback:"💳",
"Other Income":"💵",

Food:"🍔",
Groceries:"🛒",
Rent:"🏠",
Electricity:"⚡",
"Water Bill":"💧",
"Gas Bill":"🔥",
Internet:"📶",
"Mobile Recharge":"📱",
Transportation:"🚕",
Fuel:"⛽",
Shopping:"🛍",
Clothing:"👕",
Healthcare:"🏥",
Medicine:"💊",
Education:"🎓",
Entertainment:"🎬",
Travel:"✈️",
Subscription:"📺",
"EMI / Loan":"💳",
"Personal Care":"🧴",
Pets:"🐶",
Charity:"❤️",
Family:"👨‍👩‍👧",
Maintenance:"🔧",
Gifts:"🎁",
"Other Expense":"📦"

};

const typeSelect = document.getElementById("type");
const categorySelect = document.getElementById("category");

function loadCategories(){

    categorySelect.innerHTML="";

    const list =
    typeSelect.value==="income"
    ? incomeCategories
    : expenseCategories;

    list.forEach(item=>{

        const option=document.createElement("option");

        option.value=item;          

        option.textContent=
        `${emojiMap[item]} ${item}`;

        categorySelect.appendChild(option);

    });

}

loadCategories();

typeSelect.addEventListener(
"change",
loadCategories
);
// Restrict future dates

document.getElementById("date").max =
new Date().toISOString().split("T")[0];

</script>