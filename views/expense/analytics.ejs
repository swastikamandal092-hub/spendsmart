<% layout("/layout/boilerplate") %>

<%
const months = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
];

const money = (n) => new Intl.NumberFormat("en-IN", {
    maximumFractionDigits: 2
}).format(Number(n) || 0);

const total = values.reduce((sum, value) => sum + value, 0);

const peakIndex = values.length ? values.indexOf(Math.max.apply(null, values)) : 0;

const peakLabel = labels[peakIndex]
    ? (Array.isArray(labels[peakIndex]) ? labels[peakIndex].join(" ") : labels[peakIndex])
    : "—";

const peakValue = values[peakIndex] || 0;

const average = values.length ? total / values.length : 0;

const currentYear = new Date().getFullYear();
%>

<div class="page-head">

    <div>

        <span class="eyebrow">
            <i class="fa-solid fa-arrow-trend-down"></i>
            Analytics
        </span>

        <h1>Expense Analytics</h1>

        <p class="page-sub">
            Spot the weeks where your spending spikes the most.
        </p>

    </div>

    <a href="/transaction/new" class="btn-cta solid">
        <i class="fa-solid fa-plus"></i>
        Add expense
    </a>

</div>


<div class="chip-row" style="margin-bottom:18px;">

    <a href="/transaction/expense/analytics" class="filter-chip is-active">
        <i class="fa-solid fa-chart-column"></i>
        Bar graph
    </a>

    <a href="/transaction/expense/piechart" class="filter-chip">
        <i class="fa-solid fa-chart-pie"></i>
        Doughnut
    </a>

</div>


<form
    class="analytics-toolbar"
    method="GET"
    action="/transaction/expense/analytics"
    id="filterForm">

    <label class="pill-select" for="filterRange">
        <i class="fa-solid fa-sliders"></i>

        <select name="filter" id="filterRange">

            <option value="month" <%= filter === "month" ? "selected" : "" %>>
                By month
            </option>

            <option value="week" <%= filter === "week" ? "selected" : "" %>>
                By week
            </option>

            <option value="year" <%= filter === "year" ? "selected" : "" %>>
                By year
            </option>

        </select>
    </label>


    <label class="pill-select" for="weekSelect">
        <i class="fa-solid fa-calendar-week"></i>

        <select name="week" id="weekSelect">

            <% for (let i = 1; i <= 5; i++) { %>

                <option value="<%= i %>" <%= selectedWeek === i ? "selected" : "" %>>
                    Week <%= i %>
                </option>

            <% } %>

        </select>
    </label>


    <label class="pill-select" for="monthSelect">
        <i class="fa-regular fa-calendar"></i>

        <select name="month" id="monthSelect">

            <% months.forEach((month, index) => { %>

                <option
                    value="<%= index + 1 %>"
                    <%= selectedMonth === index + 1 ? "selected" : "" %>>

                    <%= month %>

                </option>

            <% }) %>

        </select>
    </label>


    <label class="pill-select" for="yearSelect">
        <i class="fa-regular fa-calendar-days"></i>

        <select name="year" id="yearSelect">

            <% for (let y = currentYear; y >= 2000; y--) { %>

                <option value="<%= y %>" <%= selectedYear === y ? "selected" : "" %>>
                    <%= y %>
                </option>

            <% } %>

        </select>
    </label>


    <button type="submit" class="btn-cta solid" style="flex:0 0 auto;">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        Apply
    </button>

</form>


<div class="chart-summary">

    <div class="mini-stat">
        <span>Total</span>
        <strong>₹ <%= money(total) %></strong>
    </div>

    <div class="mini-stat">
        <span>Highest</span>
        <strong><%= peakLabel %></strong>
    </div>

    <div class="mini-stat">
        <span>Average</span>
        <strong>₹ <%= money(average) %></strong>
    </div>

</div>


<section class="chart-card" data-reveal="60">

    <div class="card-head">

        <div>

            <h3>Expense overview</h3>

            <p class="card-sub">
                ₹ <%= money(peakValue) %> spent in the heaviest period
            </p>

        </div>

        <span class="chip chip-brand">
            <i class="fa-solid fa-indian-rupee-sign"></i>
            INR
        </span>

    </div>

    <div class="chart-shell">
        <canvas id="expenseChart"></canvas>
    </div>

    <p class="graph-period" id="showingPeriod">
        Showing data for:
        <% if (filter === "year") { %>
            <%= selectedYear %>
        <% } else if (filter === "week") { %>
            Week <%= selectedWeek %> • <%= months[selectedMonth - 1] %> <%= selectedYear %>
        <% } else { %>
            <%= months[selectedMonth - 1] %> <%= selectedYear %>
        <% } %>
    </p>

    <% if (total === 0) { %>

        <div class="empty-state" style="margin-top:18px;">

            <span class="empty-emoji">🍃</span>

            <h4>No expenses in this period</h4>

            <p>Nice! Try another month, week or year to compare.</p>

        </div>

    <% } %>

</section>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

(function () {

    const labels = <%- JSON.stringify(labels) %>;
    const values = <%- JSON.stringify(values) %>;

    const canvas = document.getElementById("expenseChart");

    if (!canvas || typeof Chart === "undefined") {
        return;
    }

    const ctx = canvas.getContext("2d");

    const gradient = ctx.createLinearGradient(0, 0, 0, 320);
    gradient.addColorStop(0, "#fb7185");
    gradient.addColorStop(1, "#e11d48");

    const font = "'Plus Jakarta Sans', system-ui, sans-serif";

    const formatMoney = (value) =>
        "₹" + new Intl.NumberFormat("en-IN", {
            maximumFractionDigits: 0
        }).format(value);

    new Chart(ctx, {

        type: "bar",

        data: {

            labels: labels,

            datasets: [{
                label: "Expense",
                data: values,
                backgroundColor: gradient,
                hoverBackgroundColor: "#be123c",
                borderRadius: 9,
                borderSkipped: false,
                maxBarThickness: 34
            }]

        },

        options: {

            responsive: true,
            maintainAspectRatio: false,

            animation: {
                duration: 900,
                easing: "easeOutQuart"
            },

            plugins: {

                legend: { display: false },

                tooltip: {
                    backgroundColor: "#0f172a",
                    padding: 12,
                    cornerRadius: 10,
                    displayColors: false,
                    titleFont: { family: font, size: 12, weight: "700" },
                    bodyFont: { family: font, size: 12, weight: "600" },
                    callbacks: {
                        label: (item) => " Expense: " + formatMoney(item.parsed.y)
                    }
                }

            },

            scales: {

                x: {
                    grid: { display: false },
                    border: { display: false },
                    ticks: {
                        color: "#94a3b8",
                        autoSkip: true,
                        maxRotation: 0,
                        font: { family: font, size: 11, weight: "600" }
                    }
                },

                y: {
                    beginAtZero: true,
                    grid: {
                        color: "#eef0f8",
                        drawTicks: false
                    },
                    border: { display: false },
                    ticks: {
                        color: "#94a3b8",
                        maxTicksLimit: 5,
                        font: { family: font, size: 11, weight: "600" },
                        callback: (value) => formatMoney(value)
                    }
                }

            }

        }

    });

}());

</script>
